# Copy these settings into your local .env file.
# Keep GLEAN_INDEXING_API_TOKEN secret. Never commit a populated .env.

GLEAN_API_URL=
GLEAN_INDEXING_API_TOKEN=
GLEAN_DATASOURCE_NAME=simplest
GLEAN_DATASOURCE_DISPLAY_NAME="Simplest CMS"
GLEAN_DATASOURCE_CATEGORY=PUBLISHED_CONTENT
SIMPLEST_BASE_URL=http://localhost:4173
GLEAN_DOCUMENT_URL_REGEX=^http://localhost:4173/.*
GLEAN_ALLOWED_USERS=
GLEAN_IS_TEST_DATASOURCE=true
